# Upstream has no tagged releases; version taken from meson.build/go.mod
# metadata and pinned to the commit above. Bump both together on update.
#
# main() lives under ./src (module root has no buildable package), so
# `go install` names the built binary "src" after the package dir; the
# default go build_style do_install() would install it verbatim as
# /usr/bin/src, hence the explicit rename below.

do_install() {
	vbin "${GOPATH}/bin/src" fabric-cli
	vcompletion autocompletions/bash_autocomplete bash fabric-cli
	vcompletion autocompletions/zsh_autocomplete zsh fabric-cli
	vcompletion autocompletions/fish_autocomplete fish fabric-cli
	vlicense LICENSE
}
