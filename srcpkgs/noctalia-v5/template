 libsndfile-devel jemalloc-devel"

# Target znver1 (Zen 1) explicitly rather than relying on
# native_optimizations/-march=native, which would instead bake in
# whatever CPU the CI runner happens to have. This keeps codegen
# reproducible and correct for the actual install target regardless
# of the build host. xbps-src's hardening env prepends its own flags
# on top of these later in the build, so -march/-mtune here still win.
CFLAGS+=" -march=znver1 -mtune=znver1"
CXXFLAGS+=" -march=znver1 -mtune=znver1"
short_desc="Lightweight Wayland shell built directly on Wayland and OpenGL ES"
maintainer="n3ptune-planet <n3ptune@plan3t>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia"
distfiles="https://github.com/noctalia-dev/noctalia/archive/${_commit}.tar.gz"
checksum=c1b30c0308e9c0acdd0f637265cd0e4a960a4529c4f40a2ccd24cae4e77c69ca
wrksrc="noctalia-${_commit}"

post_install() {
	vlicense LICENSE
	vdoc README.md
}
