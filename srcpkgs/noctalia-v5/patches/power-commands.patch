+  // process::runAsync(vector<string>)'s bool return only tells you whether execve() itself
+  // succeeded in the double-forked child - not whether the command actually did anything. A
+  // permission-denied `init 6`/`init 0`/`zzz` execs fine and then fails at runtime, which used
+  // to be reported as success, so the fallback loop below stopped on the very first candidate
+  // that merely *existed*, and pkexec/sudo fallbacks that might have actually worked were never
+  // tried. probeLaunch() fixes this without ever killing a legitimately-running command: it
+  // launches via the callback-based process::runAsync (which does NOT apply an internal
+  // timeout/kill unless one is requested) and waits up to `gracePeriod` for it to exit. A
+  // permission failure reports its exit code well within that window. A real suspend (blocks on
+  // the /sys/power/state write until resume), a real reboot/shutdown (tearing down services), or
+  // a pkexec/run0 prompt waiting on a password all outlive the window - in that case we do NOT
+  // kill anything, we just stop watching and treat it as success; process::runAsync's own worker
+  // thread keeps running until the process eventually exits and reaps it.
+  struct ProbeState {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool done = false;
+    process::RunResult result;
+  };
+
+  struct ProbeOutcome {
+    bool started = false;      // false only if process::runAsync couldn't even spawn a worker
+    bool stillRunning = false; // outlived gracePeriod without exiting - assume it's proceeding
+    process::RunResult result; // valid only when started && !stillRunning
+  };
+
+  template <typename Command>
+  [[nodiscard]] ProbeOutcome probeLaunch(const Command& command, std::chrono::milliseconds gracePeriod) {
+    auto state = std::make_shared<ProbeState>();
+
+    const bool started = process::runAsync(
+        command, process::RunCallbacks{
+                     .onExit =
+                         [state](process::RunResult result) {
+                           std::scoped_lock lock(state->mutex);
+                           state->result = std::move(result);
+                           state->done = true;
+                           state->cv.notify_all();
+                         }
+                 }
+    );
+    if (!started) {
+      return ProbeOutcome{.started = false};
+    }
+
+    std::unique_lock lock(state->mutex);
+    const bool exitedInTime = state->cv.wait_for(lock, gracePeriod, [&state] { return state->done; });
+    if (!exitedInTime) {
+      return ProbeOutcome{.started = true, .stillRunning = true};
+    }
+    return ProbeOutcome{.started = true, .stillRunning = false, .result = state->result};
+  }
+
