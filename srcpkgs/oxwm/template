# Zig's package manager needs network access to resolve build.zig.zon
# dependencies, which xbps-src's masterdir chroot does not allow. Pre-seed
# the global Zig package cache with the vendored Lua tarball, keyed by the
# content hash pinned in build.zig.zon, so `zig build` resolves it from
# disk instead of trying (and failing) to fetch it.
export ZIG_GLOBAL_CACHE_DIR="${XBPS_BUILDDIR}/zig-cache"

pre_build() {
	local _luahash="N-V-__8AAKEzFAAA695b9LXBhUSVK5MAV_VKSm1mEj3Acbze"
	mkdir -p "${ZIG_GLOBAL_CACHE_DIR}/p/${_luahash}"
	bsdtar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/lua-5.4.8.tar.gz" \
		-C "${ZIG_GLOBAL_CACHE_DIR}/p/${_luahash}" --strip-components=1
}

post_install() {
	vlicense LICENSE
	vdoc readme.org
}
