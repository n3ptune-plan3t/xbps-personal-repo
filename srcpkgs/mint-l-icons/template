checksum=431dcef7609ca173d850eef875a94bac1841fff5ce28d742bafdcc99fcb871e6

do_install() {
	vcopy 'usr/share' usr

	for f in "${DESTDIR}"/usr/share/icons/Mint-L*/index.theme; do
		vsed -i "${f}" -e 's/,hicolor$/,hicolor,Papirus,Papirus-Dark,Papirus-Light/'
	done
}
