# Template file for 'caffyne-shell'
pkgname=caffyne
version=0.1.0.12ebcd2
revision=1
hostmakedepends="python3-devel python3-pip cmake git pkg-config"
makedepends="gtk+3-devel cairo-devel libgirepository-devel libdbusmenu-glib-devel libbluetooth-devel python3-cairo-devel libglib-devel"
depends="awww matugen cinnamon-desktop playerctl gnome-bluetooth bluez brightnessctl NetworkManager python3-loguru python3-click"
short_desc="New, lightweight, desktop shell for linux, powered by Fabric"
maintainer="Terromur <terromuroz@proton.me>"
license="GPL-3.0-or-later"
homepage="https://caffyne.org/"
_commit="12ebcd2"
distfiles="https://github.com/caffyne-org/caffyne-shell/archive/${_commit}.tar.gz"
checksum=72a4cc0de7931fe94cdf86bc0643d5ff714c5c850675b483a350b28c3a52f9d0
python_version=3
wrksrc="caffyne-shell-${_commit}"

do_build() {
	make -C snippets/blur/lib
	make -C snippets/hacktk/lib
}

do_install() {
	vsed -i '3i python3 -m venv ~/.config/caffyne-shell/venv' start.sh
	python3 -m venv venv && . venv/bin/activate
	pip install -U pip pycairo fabric-cli -r requirements.txt
	pip install -U pip pycairo -r requirements.txt
	rm -rf venv
	vmkdir etc/xdg/caffyne-shell
	vcopy '*' etc/xdg/caffyne-shell/
}
