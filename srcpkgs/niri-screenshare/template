# Template file for 'niri-screenshare'
pkgname=niri-screenshare
version=0.2.1
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="gtk4-devel libadwaita-devel"
depends="xdg-desktop-portal niri pipewire"
short_desc="xdg-desktop-portal ScreenCast backend for niri"
maintainer="n3ptune-planet <n3ptune@plan3t>"
license="GPL-3.0-or-later"
homepage="https://github.com/pantarune/niri-screenshare"
distfiles="https://github.com/pantarune/niri-screenshare/archive/v${version}.tar.gz"
checksum=21b8e82eae5c9aadaa2bc7cdfc0cd2350b2aad0accdd4601443c572a0e056712

# v0.2.1 is a real upstream git tag (verified it matches the tip of the
# default branch at the time this template was written), so this is a
# normal versioned tarball, not a _commit-pinned snapshot like the
# other Fabric/Noctalia templates.
#
# "picker" (the default cargo feature) pulls in gtk4 + libadwaita for
# the source-picker dialog; the alternative is building with
# `configure_args="--no-default-features"` for a dialog-less dynamic-cast
# build, which would let gtk4-devel/libadwaita-devel be dropped from
# makedepends too. Kept the default (picker) build here since it's what
# upstream ships by default and what most users expect.
#
# Binary is installed to /usr/lib, not /usr/bin: it's exclusively
# D-Bus/portal-activated (matches upstream's own contrib/PKGBUILD), never
# invoked directly by a user or from $PATH, aside from the optional
# `--debug-picker` flag for manual testing.
#
# The systemd user unit shipped upstream (data/niri-screenshare.service)
# is intentionally NOT installed - Void uses runit, not systemd,
# and it is not required for correct operation: dbus-daemon activates
# services via the plain Exec= line in the .service file below
# regardless of init system, so first-use lazy D-Bus activation works
# identically without a systemd unit present. data/niri-portals.conf is
# also not installed - it's dead reference material even in upstream's
# own PKGBUILD; the binary writes ~/.config/xdg-desktop-portal/portals.conf
# itself on first run (see src/portal_config.rs).

do_install() {
	vinstall "target/${RUST_TARGET}/release/niri-screenshare" 755 usr/lib
	vinstall data/niri.portal 644 usr/share/xdg-desktop-portal/portals
	vinstall data/org.freedesktop.impl.portal.desktop.niri.service 644 \
		usr/share/dbus-1/services
	vlicense LICENSE
	vdoc README.md
}
